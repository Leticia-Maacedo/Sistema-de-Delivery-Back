{
  "info": {
    "name": "EntregaFood — Teste: excluir produto da Cesta",
    "description": "Teste funcional do endpoint DELETE /cesta/itens/{produto_id}. Rode a coleção inteira em ordem (Run collection). Ela cria os próprios usuários de teste, pausa e restaura um produto, e limpa as cestas. Única variável a ajustar: base_url.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparação",
      "item": [
        {
          "name": "00.0 Login do administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_admin}}\",\n  \"senha\": \"{{senha_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Conta admin do ambiente (variáveis email_admin e senha_admin). Aprova restaurantes e altera produtos dos restaurantes de exemplo, que não têm dono."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin logado', () => pm.response.to.have.status(200));",
                  "pm.test('Conta do tipo admin', () => pm.expect(pm.response.json().usuario.tipo).to.eql('admin'));",
                  "pm.collectionVariables.set('token_admin', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.1 Cadastrar cliente A (teste)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
