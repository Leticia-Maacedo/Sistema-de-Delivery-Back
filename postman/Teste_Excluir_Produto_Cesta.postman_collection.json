            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "Pré-condição.",
            "body": {
              "mode": "raw",
