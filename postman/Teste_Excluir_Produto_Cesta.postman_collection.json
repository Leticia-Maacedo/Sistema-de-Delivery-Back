        },
        {
          "name": "CT-11 Exclusão não apaga o produto do catálogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes/{{restaurante_id}}/cardapio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
