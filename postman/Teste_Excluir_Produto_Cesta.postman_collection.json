              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Cliente descartável.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente A Exclusao Cesta\",\n  \"email\": \"{{email_a}}\",\n  \"senha\": \"{{senha_a}}\",\n  \"tipo\": \"cliente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = Date.now() + '' + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('email_a', `teste.exclusao.a.${sufixo}@entregafood.com`);",
                  "pm.collectionVariables.set('senha_a', 'Tst' + Math.random().toString(36).slice(2, 12));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "00.2 Login cliente A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
