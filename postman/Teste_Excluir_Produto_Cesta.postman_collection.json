    {
      "name": "3. Regras de negócio",
      "item": [
        {
          "name": "CT-10 Adicionar de novo depois de excluir",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "O produto volta como item novo, com a quantidade enviada (não restaura as 3 unidades antigas).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id}},\n  \"quantidade\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('Quantidade 1 (não 3 + 1)', () => pm.expect(item('produto_id').quantidade).to.eql(1));",
                  "pm.test('1 item', () => pm.expect(c.itens.length).to.eql(1));"
                ]
              }
            }
