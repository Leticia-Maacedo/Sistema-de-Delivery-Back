                  "const ids = pm.response.json().itens.map(i => i.id);",
                  "pm.test('Produtos 1 e 2 continuam no cardápio', () => { pm.expect(ids).to.include(Number(pm.collectionVariables.get('produto_id'))); pm.expect(ids).to.include(Number(pm.collectionVariables.get('produto_id_2'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "00.7 Tornar produto 1 indisponível",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produtos",
                "{{produto_id}}"
              ]
            },
            "description": "Simula o restaurante pausando o item que está na cesta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disponivel\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-12 Excluir item que ficou indisponível",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id}}"
              ]
            },
            "description": "O cliente precisa conseguir tirar da cesta um item que o restaurante pausou."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
