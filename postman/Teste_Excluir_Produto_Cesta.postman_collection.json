    {
      "name": "1. Exclusões válidas",
      "item": [
        {
          "name": "CT-01 Excluir um item da cesta",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id_2}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id_2}}"
              ]
            },
            "description": "Cenário principal: remove o produto 2 e mantém o produto 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Produto 2 removido', () => pm.expect(item('produto_id_2')).to.be.undefined);",
                  "pm.test('Produto 1 continua com 3', () => pm.expect(item('produto_id').quantidade).to.eql(3));",
                  "pm.test('Total = só o produto 1', () => pm.expect(Number(c.total)).to.be.closeTo(Number(v('preco')) * 3, 0.001));",
                  "pm.test('Mesma cesta', () => pm.expect(c.id).to.eql(Number(v('cesta_id'))));",
                  "pm.test('atualizado_em avançou', () => pm.expect(c.atualizado_em).to.not.eql(v('atualizado_em')));",
                  "pm.test('Tempo < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-02 Exclusão fica gravada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Nova consulta confirma a remoção."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Só 1 item (produto 1)', () => { pm.expect(c.itens.length).to.eql(1); pm.expect(item('produto_id')).to.not.be.undefined; });"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-03 Exclui o item inteiro, mesmo com quantidade 3",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id}}"
              ]
            },
            "description": "DELETE remove a linha toda, não diminui uma unidade."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Produto 1 removido por completo', () => pm.expect(item('produto_id')).to.be.undefined);",
                  "pm.test('Cesta sem itens e total 0.00', () => { pm.expect(c.itens).to.eql([]); pm.expect(c.total).to.eql('0.00'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-04 Cesta vazia continua existindo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Remover o último item não apaga a cesta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id da cesta mantido', () => pm.expect(c.id).to.eql(Number(v('cesta_id'))));",
                  "pm.test('itens = [] e total 0.00', () => { pm.expect(c.itens).to.eql([]); pm.expect(c.total).to.eql('0.00'); });"
                ]
              }
            }
          ]
        }
      ]
    },
