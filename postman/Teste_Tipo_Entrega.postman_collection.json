    {
      "name": "1. Casos de teste",
      "item": [
        {
          "name": "CT-01 Resumo com entrega (delivery)",
          "item": [
            {
              "name": "Resumo delivery",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token_a}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/cesta/resumo?tipo_entrega=delivery",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "cesta",
                    "resumo"
                  ],
                  "query": [
                    {
                      "key": "tipo_entrega",
                      "value": "delivery"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200', () => pm.response.to.have.status(200));",
                      "const r = pm.response.json();",
                      "pm.test('tipo_entrega = delivery', () => pm.expect(r.tipo_entrega).to.eql('delivery'));",
                      "pm.test('Taxa maior que zero', () => pm.expect(Number(r.taxa_entrega)).to.be.above(0));",
                      "pm.test('Distância calculada', () => pm.expect(Number(r.distancia_km)).to.be.above(0));",
                      "pm.test('Total = subtotal + taxa', () => pm.expect(Number(r.total)).to.be.closeTo(Number(r.subtotal) + Number(r.taxa_entrega), 0.001));",
                      "pm.test('Pode fechar', () => pm.expect(r.pode_fechar).to.be.true);",
                      "pm.collectionVariables.set('taxa_delivery', r.taxa_entrega);",
                      "pm.collectionVariables.set('total_delivery', r.total);",
                      "pm.collectionVariables.set('subtotal', r.subtotal);"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "CT-02 Resumo com retirada no balcão",
          "item": [
            {
              "name": "Resumo retirada",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token_a}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/cesta/resumo?tipo_entrega=retirada",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "cesta",
                    "resumo"
                  ],
                  "query": [
                    {
                      "key": "tipo_entrega",
                      "value": "retirada"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200', () => pm.response.to.have.status(200));",
                      "const r = pm.response.json();",
                      "pm.test('tipo_entrega = retirada', () => pm.expect(r.tipo_entrega).to.eql('retirada'));",
                      "pm.test('Taxa = 0.00', () => pm.expect(Number(r.taxa_entrega)).to.eql(0));",
                      "pm.test('Sem distância', () => pm.expect(r.distancia_km).to.be.null);",
                      "pm.test('Total = subtotal', () => pm.expect(r.total).to.eql(r.subtotal));",
                      "pm.test('Mesmo subtotal do delivery', () => pm.expect(r.subtotal).to.eql(pm.collectionVariables.get('subtotal')));",
                      "pm.test('Pode fechar', () => pm.expect(r.pode_fechar).to.be.true);"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "CT-03 Sem informar o tipo usa delivery",
          "item": [
            {
              "name": "Resumo sem tipo",
