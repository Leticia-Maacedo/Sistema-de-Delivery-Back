                    "exec": [
                      "pm.test('200', () => pm.response.to.have.status(200));",
                      "pm.test('Padrão = delivery', () => pm.expect(pm.response.json().tipo_entrega).to.eql('delivery'));",
                      "pm.test('Mesma taxa do CT-01', () => pm.expect(pm.response.json().taxa_entrega).to.eql(pm.collectionVariables.get('taxa_delivery')));"
                    ]
