{
  "info": {
    "name": "EntregaFood — Teste: consultar itens da Cesta",
    "description": "Teste funcional do endpoint GET /cesta. Rode a coleção inteira em ordem (Run collection). Ela cria os próprios usuários de teste com senha aleatória, monta a cesta, executa os casos, restaura o produto alterado e esvazia a cesta. Única variável a ajustar: base_url.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparação",
      "item": [
        {
          "name": "00.1 Cadastrar cliente A (teste)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Cliente descartável com e-mail e senha aleatórios.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente A Consulta Cesta\",\n  \"email\": \"{{email_a}}\",\n  \"senha\": \"{{senha_a}}\",\n  \"tipo\": \"cliente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = Date.now() + '' + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('email_a', `teste.consulta.a.${sufixo}@entregafood.com`);",
                  "pm.collectionVariables.set('senha_a', 'Tst' + Math.random().toString(36).slice(2, 12));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('usuario_id_a', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.2 Login cliente A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda o JWT em {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_a}}\",\n  \"senha\": \"{{senha_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.3 Escolher restaurante aprovado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes"
              ]
            },
            "description": "Primeiro restaurante aprovado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('restaurante_id', pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.4 Escolher dois produtos do cardápio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes/{{restaurante_id}}/cardapio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes",
                "{{restaurante_id}}",
                "cardapio"
              ]
            },
            "description": "Guarda id, nome e preço dos dois primeiros itens disponíveis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "pm.test('200 OK e ao menos 2 itens', () => { pm.response.to.have.status(200); pm.expect(c.itens.length).to.be.at.least(2); });",
                  "pm.collectionVariables.set('produto_id', c.itens[0].id); pm.collectionVariables.set('nome_1', c.itens[0].nome); pm.collectionVariables.set('preco', c.itens[0].preco);",
                  "pm.collectionVariables.set('produto_id_2', c.itens[1].id); pm.collectionVariables.set('nome_2', c.itens[1].nome); pm.collectionVariables.set('preco_2', c.itens[1].preco);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Cesta vazia",
      "item": [
        {
          "name": "CT-01 Cliente sem cesta → cesta vazia",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Cliente recém-criado nunca adicionou nada: a API devolve uma cesta vazia (não 404)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id nulo (cesta ainda não existe no banco)', () => pm.expect(c.id).to.be.null);",
                  "pm.test('cliente_id é o do usuário logado', () => pm.expect(c.cliente_id).to.eql(Number(pm.collectionVariables.get('usuario_id_a'))));",
                  "pm.test('itens = [] e total = 0.00', () => { pm.expect(c.itens).to.eql([]); pm.expect(c.total).to.eql('0.00'); });",
                  "pm.test('criado_em e atualizado_em nulos', () => { pm.expect(c.criado_em).to.be.null; pm.expect(c.atualizado_em).to.be.null; });"
                ]
              }
            }
          ]
        },
        {
          "name": "00.5 Adicionar produto 1 (quantidade 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "Prepara a cesta para os próximos casos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id}},\n  \"quantidade\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "00.6 Adicionar produto 2 (quantidade 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "Segundo item.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id_2}},\n  \"quantidade\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Consulta com itens",
      "item": [
        {
          "name": "CT-02 Consultar cesta com itens",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Cenário principal: a cesta volta com os dois itens adicionados."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type JSON', () => pm.response.to.have.header('content-type', 'application/json'));",
                  "pm.test('Campos da cesta presentes', () => pm.expect(c).to.have.all.keys('id', 'cliente_id', 'criado_em', 'atualizado_em', 'itens', 'total'));",
                  "pm.test('id da cesta preenchido', () => pm.expect(c.id).to.be.a('number'));",
                  "pm.test('2 itens', () => pm.expect(c.itens.length).to.eql(2));",
                  "pm.collectionVariables.set('cesta_id', c.id);",
                  "pm.collectionVariables.set('atualizado_em', c.atualizado_em);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-03 Estrutura e tipos de cada item",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Contrato do item: campos e tipos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "pm.test('Cada item tem os 6 campos', () => c.itens.forEach(i => pm.expect(i).to.have.all.keys('id', 'produto_id', 'nome', 'quantidade', 'preco_unitario', 'subtotal')));",
                  "pm.test('Tipos corretos', () => c.itens.forEach(i => {",
                  "  pm.expect(i.id).to.be.a('number'); pm.expect(i.produto_id).to.be.a('number');",
                  "  pm.expect(i.nome).to.be.a('string'); pm.expect(i.quantidade).to.be.a('number');",
                  "  pm.expect(i.preco_unitario).to.match(/^\\d+\\.\\d{2}$/); pm.expect(i.subtotal).to.match(/^\\d+\\.\\d{2}$/);",
                  "}));",
                  "pm.test('total com 2 casas decimais', () => pm.expect(c.total).to.match(/^\\d+\\.\\d{2}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-04 Quantidades, subtotais e total",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Cálculos feitos pelo servidor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "const pr1 = Number(pm.collectionVariables.get('preco')), pr2 = Number(pm.collectionVariables.get('preco_2'));",
                  "pm.test('Quantidades 2 e 1', () => { pm.expect(i1.quantidade).to.eql(2); pm.expect(i2.quantidade).to.eql(1); });",
                  "pm.test('subtotal = preço × quantidade', () => {",
                  "  pm.expect(Number(i1.subtotal)).to.be.closeTo(pr1 * 2, 0.001);",
                  "  pm.expect(Number(i2.subtotal)).to.be.closeTo(pr2 * 1, 0.001);",
                  "});",
                  "pm.test('total = soma dos subtotais', () => pm.expect(Number(c.total)).to.be.closeTo(pr1 * 2 + pr2, 0.001));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-05 Nome e preço conferem com o cardápio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Os dados do item batem com o produto do cardápio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "pm.test('Nomes iguais aos do cardápio', () => { pm.expect(i1.nome).to.eql(pm.collectionVariables.get('nome_1')); pm.expect(i2.nome).to.eql(pm.collectionVariables.get('nome_2')); });",
                  "pm.test('Preços iguais aos do cardápio', () => { pm.expect(i1.preco_unitario).to.eql(pm.collectionVariables.get('preco')); pm.expect(i2.preco_unitario).to.eql(pm.collectionVariables.get('preco_2')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-06 Ordem dos itens = ordem de inclusão",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Itens ordenados pelo id do item (ordem em que entraram)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "pm.test('Primeiro item é o produto 1', () => pm.expect(c.itens[0].produto_id).to.eql(p1));",
                  "pm.test('ids de item crescentes', () => pm.expect(c.itens[0].id).to.be.below(c.itens[1].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-07 Consulta não altera a cesta (somente leitura)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Consultar de novo devolve os mesmos dados e não mexe em atualizado_em."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "pm.test('Mesma cesta', () => pm.expect(c.id).to.eql(Number(pm.collectionVariables.get('cesta_id'))));",
                  "pm.test('atualizado_em não mudou', () => pm.expect(c.atualizado_em).to.eql(pm.collectionVariables.get('atualizado_em')));",
                  "pm.test('Tempo de resposta < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "00.7 Alterar quantidade do produto 1 para 5",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id}}"
              ]
            },
            "description": "Muda a cesta para verificar que a consulta reflete.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-08 Consulta reflete alteração de quantidade",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Depois do PUT, a consulta mostra quantidade 5 e total recalculado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "const pr1 = Number(pm.collectionVariables.get('preco')), pr2 = Number(pm.collectionVariables.get('preco_2'));",
                  "pm.test('Quantidade 5', () => pm.expect(i1.quantidade).to.eql(5));",
                  "pm.test('Total recalculado', () => pm.expect(Number(c.total)).to.be.closeTo(pr1 * 5 + pr2, 0.001));",
                  "pm.test('atualizado_em avançou', () => pm.expect(c.atualizado_em).to.not.eql(pm.collectionVariables.get('atualizado_em')));"
                ]
              }
            }
          ]
        },
