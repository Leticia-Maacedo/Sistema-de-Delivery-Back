                ]
              }
            }
          ]
        },
        {
          "name": "CT-09 Consulta reflete remoção de item",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Só o produto 1 continua."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const p1 = Number(pm.collectionVariables.get('produto_id'));",
                  "const p2 = Number(pm.collectionVariables.get('produto_id_2'));",
                  "const i1 = (c.itens || []).find(i => i.produto_id === p1);",
                  "const i2 = (c.itens || []).find(i => i.produto_id === p2);",
                  "",
                  "const pr1 = Number(pm.collectionVariables.get('preco'));",
                  "pm.test('1 item', () => pm.expect(c.itens.length).to.eql(1));",
                  "pm.test('Produto 2 não aparece', () => pm.expect(i2).to.be.undefined);",
                  "pm.test('Total = só o produto 1', () => pm.expect(Number(c.total)).to.be.closeTo(pr1 * 5, 0.001));"
                ]
              }
            }
          ]
        }
