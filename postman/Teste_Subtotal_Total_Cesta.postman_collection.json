                  "pm.test('sem distância', () => { pm.expect(r.distancia_km).to.be.null; pm.expect(r.metodo_distancia).to.be.null; });",
                  "pm.test('pode fechar', () => pm.expect(r.pode_fechar).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-04 Entrega: taxa pela distância",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/resumo?local_id={{local_a}}&tipo_entrega=delivery",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "resumo"
              ],
              "query": [
                {
                  "key": "local_id",
                  "value": "{{local_a}}"
                },
                {
                  "key": "tipo_entrega",
                  "value": "delivery"
                }
              ]
            },
            "description": "Distância estimada (linha reta × 1,6) e taxa = base R$ 4,00 + taxa_entrega_km × km além de 2 km, arredondada para cima em R$ 0,10."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const n = (x) => Number(x);",
                  "",
                  "const hav = (a1, o1, a2, o2) => { const rad = (x) => x * Math.PI / 180, R = 6371.0088;",
                  "  const h = Math.sin(rad(a2 - a1) / 2) ** 2 + Math.cos(rad(a1)) * Math.cos(rad(a2)) * Math.sin(rad(o2 - o1) / 2) ** 2;",
                  "  return Math.round(2 * R * Math.asin(Math.sqrt(h)) * 1000) / 1000; };",
                  "const distEsperada = Math.round(hav(n(v('rest_lat')), n(v('rest_lon')), n(v('cli_lat')), n(v('cli_lon'))) * 1.6 * 1000) / 1000;",
                  "const taxaEsperada = Math.ceil(Math.max(4, 4 + n(v('taxa_km')) * Math.max(0, distEsperada - 2)) * 10 - 1e-9) / 10;",
                  "",
                  "pm.test('200 e pode fechar', () => { pm.response.to.have.status(200); pm.expect(r.pode_fechar).to.eql(true); });",
                  "pm.test('método estimada (sem chave do OpenRouteService)', () => pm.expect(r.metodo_distancia).to.eql('estimada'));",
                  "pm.test('distância = linha reta × 1,6', () => pm.expect(n(r.distancia_km)).to.be.closeTo(distEsperada, 0.002));",
                  "pm.test('taxa conforme a regra', () => pm.expect(n(r.taxa_entrega)).to.be.closeTo(taxaEsperada, 0.001));",
                  "pm.test('total = subtotal + taxa', () => pm.expect(n(r.total)).to.be.closeTo(n(r.subtotal) + n(r.taxa_entrega), 0.001));",
                  "pm.test('endereço usado', () => pm.expect(r.local_entrega_id).to.eql(n(v('local_a'))));",
                  "pm.collectionVariables.set('taxa', r.taxa_entrega); pm.collectionVariables.set('total', r.total);"
                ]
              }
            }
          ]
        },
