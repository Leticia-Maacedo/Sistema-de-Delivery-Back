                  "pm.test('subtotal com 5 unidades', () => pm.expect(n(r.subtotal)).to.be.closeTo(esperado, 0.001));",
                  "pm.test('taxa igual (mesma distância)', () => pm.expect(r.taxa_entrega).to.eql(v('taxa')));",
                  "pm.test('total = novo subtotal + taxa', () => pm.expect(n(r.total)).to.be.closeTo(esperado + n(v('taxa')), 0.001));",
                  "pm.collectionVariables.set('total', r.total); pm.collectionVariables.set('taxa', r.taxa_entrega);"
                ]
