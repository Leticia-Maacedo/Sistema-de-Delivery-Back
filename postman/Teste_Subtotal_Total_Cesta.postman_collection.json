        {
          "name": "CT-02 Subtotal = soma de preço × quantidade",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/resumo?tipo_entrega=retirada",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "resumo"
              ],
              "query": [
                {
                  "key": "tipo_entrega",
                  "value": "retirada"
                }
              ]
            },
            "description": "Confere o subtotal com os preços do cardápio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const n = (x) => Number(x);",
                  "",
                  "const esperado = n(v('preco')) * 2 + n(v('preco_2'));",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('subtotal = preço1 × 2 + preço2 × 1', () => pm.expect(n(r.subtotal)).to.be.closeTo(esperado, 0.001));",
                  "pm.test('quantidade_itens = 3', () => pm.expect(r.quantidade_itens).to.eql(3));",
                  "pm.test('restaurante da cesta', () => pm.expect(r.restaurante_id).to.eql(n(v('restaurante_id'))));",
                  "pm.collectionVariables.set('subtotal', r.subtotal);"
                ]
              }
            }
