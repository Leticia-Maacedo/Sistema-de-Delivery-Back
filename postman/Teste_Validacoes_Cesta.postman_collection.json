                ]
              }
            }
          ]
        },
        {
          "name": "00.8 Pausar produto 1 (que está na cesta)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/produtos/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produtos",
                "{{produto_id}}"
              ]
            },
            "description": "Simula o restaurante pausando um item depois de entrar na cesta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disponivel\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
