{
  "info": {
    "name": "EntregaFood — Teste: validações de quantidade e disponibilidade",
    "description": "Testa os limites de quantidade, a disponibilidade dos produtos, a regra de restaurante único e as validações do fechamento (cesta vazia, item indisponível, endereço, raio de entrega). Rode a coleção inteira em ordem. Única variável a ajustar: base_url.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparação",
      "item": [
        {
          "name": "00.1 Cadastrar cliente A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Cliente descartável.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente A Validacoes\",\n  \"email\": \"{{email_a}}\",\n  \"senha\": \"{{senha_a}}\",\n  \"tipo\": \"cliente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = Date.now() + '' + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('email_a', `teste.validacao.a.${sufixo}@entregafood.com`);",
                  "pm.collectionVariables.set('senha_a', 'Tst' + Math.random().toString(36).slice(2, 12));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('usuario_a', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.2 Login cliente A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "JWT em {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_a}}\",\n  \"senha\": \"{{senha_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.3 Endereço do cliente A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/locais",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "locais"
              ]
            },
            "description": "Praça da Sé (dentro do raio).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": {{usuario_a}},\n  \"endereco\": \"Praca da Se, s/n - Sao Paulo\",\n  \"tipo\": \"casa\",\n  \"latitude\": \"-23.550520\",\n  \"longitude\": \"-46.633308\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('local_a', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.4 Restaurantes aprovados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes"
              ]
            },
            "description": "Dois restaurantes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('2+', () => pm.expect(r.length).to.be.at.least(2));",
                  "pm.collectionVariables.set('restaurante_id', r[0].id);",
                  "pm.collectionVariables.set('restaurante_id_2', r[1].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "00.5 Produtos do restaurante 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes/{{restaurante_id}}/cardapio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes",
                "{{restaurante_id}}",
                "cardapio"
              ]
            },
            "description": "Dois itens disponíveis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set('produto_id', c.itens[0].id);",
                  "pm.collectionVariables.set('nome_1', c.itens[0].nome);",
                  "pm.collectionVariables.set('produto_id_2', c.itens[1].id);",
                  "pm.test('ok', () => pm.expect(c.itens.length).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "00.6 Produto do restaurante 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes/{{restaurante_id_2}}/cardapio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes",
                "{{restaurante_id_2}}",
                "cardapio"
              ]
            },
            "description": "Item de outro restaurante."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('produto_outro', pm.response.json().itens[0].id);",
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "00.7 Produto indisponível",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produtos?restaurante_id={{restaurante_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produtos"
              ],
              "query": [
                {
                  "key": "restaurante_id",
                  "value": "{{restaurante_id}}"
                }
              ]
            },
            "description": "Item com disponivel = false."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json().find(x => x.disponivel === false);",
                  "pm.test('existe', () => pm.expect(p).to.not.be.undefined);",
                  "pm.collectionVariables.set('produto_indisp', p.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Quantidade",
      "item": [
        {
          "name": "CT-01 Incluir 99 unidades (limite) → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "O limite por produto é 99.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id}},\n  \"quantidade\": 99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('99 unidades', () => pm.expect(item('produto_id').quantidade).to.eql(99));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-02 Somar 1 além do limite → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "99 + 1 passaria do limite.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id}},\n  \"quantidade\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensagem: Quantidade maxima', () => pm.expect(pm.response.json().detail).to.include('Quantidade maxima'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-03 Incluir 100 de uma vez → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "Produto novo com 100 unidades.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id_2}},\n  \"quantidade\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensagem: Quantidade maxima', () => pm.expect(pm.response.json().detail).to.include('Quantidade maxima'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-04 Alterar para 100 → 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id}}"
              ]
            },
            "description": "A alteração também respeita o limite.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensagem: Quantidade maxima', () => pm.expect(pm.response.json().detail).to.include('Quantidade maxima'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-05 Quantidade continua 99 após os erros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta"
              ]
            },
            "description": "Nenhum erro alterou a cesta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "pm.test('Produto 1 com 99', () => pm.expect(item('produto_id').quantidade).to.eql(99));",
                  "pm.test('Produto 2 não entrou', () => pm.expect(item('produto_id_2')).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-06 Alterar para 2 (válido) → 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id}}"
              ]
            },
            "description": "Volta a uma quantidade normal.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "const v = (k) => pm.collectionVariables.get(k);",
                  "const item = (pid) => (c.itens || []).find(i => i.produto_id === Number(v(pid)));",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('2 unidades', () => pm.expect(item('produto_id').quantidade).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-07 Quantidade zero → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens"
              ]
            },
            "description": "Barrado já na validação do corpo (mínimo 1).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produto_id\": {{produto_id_2}},\n  \"quantidade\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Disponibilidade e restaurante",
