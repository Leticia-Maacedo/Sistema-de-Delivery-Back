                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensagem: indisponivel', () => pm.expect(pm.response.json().detail).to.include('indisponivel'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-11 Resumo aponta o item indisponível",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/resumo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "resumo"
              ]
            },
            "description": "O cliente vê o motivo antes de tentar pagar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('não pode fechar', () => pm.expect(r.pode_fechar).to.eql(false));",
                  "pm.test('motivo cita o produto', () => { pm.expect(r.motivo).to.include(pm.collectionVariables.get('nome_1')); pm.expect(r.motivo).to.include('indisponivel'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-12 Fechar pedido com item pausado → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "Revalidação no fechamento (\"estoque\").",
