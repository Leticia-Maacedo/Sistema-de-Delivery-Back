{
  "info": {
    "name": "EntregaFood API",
    "description": "Coleção completa da API EntregaFood: autenticação (e-mail/senha + JWT), CRUD de Usuário, Local, Restaurante e Produto, e as consultas do cliente (Restaurante e Cardápio).\n\nFluxo sugerido para testar do zero: Cadastrar usuário (conta de restaurante) → Login → Criar local → Criar restaurante → Criar produto → Consultar restaurante/cardápio.\n\nLocais, Restaurantes e Produtos exigem o token do login: cada usuário mexe só nos próprios endereços, restaurantes e cardápios. Listar todos os restaurantes e aprovar (status_aprovacao) é só do admin; o restaurante criado nasce pendente e só aparece em Consultas depois de aprovado.\n\nOs requests de CREATE guardam automaticamente o id criado numa variável de coleção (usuario_id, local_id, restaurante_id, produto_id) e o login guarda o token em `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "local_id",
      "value": ""
    },
    {
      "key": "restaurante_id",
      "value": ""
    },
    {
      "key": "produto_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Cadastrar usuário (RF01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Geovane Soares\",\n  \"email\": \"geovane@entregafood.com\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"11999998888\",\n  \"tipo\": \"restaurante\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('usuario_id', pm.response.json().id);",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login por e-mail e senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"geovane@entregafood.com\",\n  \"senha\": \"senha123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "}",
                  "pm.test('200 OK e access_token presente', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('access_token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido (credenciais erradas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"geovane@entregafood.com\",\n  \"senha\": \"senha-errada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dados do usuário logado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/eu",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "eu"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Listar usuários (admin)",
          "request": {
            "method": "GET",
            "header": [
