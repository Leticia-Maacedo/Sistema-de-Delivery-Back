                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Geovane Soares Atualizado\"\n}"
            }
          }
        },
        {
          "name": "Excluir usuário (RF06)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_id}}"
              ]
            }
          }
        }
      ]
    },
