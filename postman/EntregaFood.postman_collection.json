    {
      "name": "Consultas (Cliente)",
      "item": [
        {
          "name": "Consultar restaurantes disponíveis",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes"
              ]
            }
          }
        },
        {
          "name": "Restaurantes que entregam no endereço (raio)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/consultas/restaurantes?latitude=-23.550520&longitude=-46.633308",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "consultas",
                "restaurantes"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "-23.550520"
                },
                {
                  "key": "longitude",
                  "value": "-46.633308"
                }
              ]
            },
            "description": "Com a latitude e a longitude do endereço do cliente, só vêm os restaurantes cujo raio de entrega cobre o endereço, do mais perto para o mais longe, com distancia_km. Use incluir_fora_do_raio=true para ver também os que não entregam."
          }
