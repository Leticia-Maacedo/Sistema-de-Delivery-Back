         "value": "{{hamburguer_id}}"
        }
       ]
      },
      "description": ""
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const v = (k) => pm.collectionVariables.get(k);",
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const c = pm.response.json();",
         "pm.test('Batata em 1º', () => pm.expect(c.sugestoes[0].id).to.eql(Number(v('batata_id'))));",
         "pm.test('Motivo: pedido junto', () => pm.expect(c.sugestoes[0].motivo).to.include('junto'));",
         "pm.test('Hambúrguer não volta', () => pm.expect(c.sugestoes.map(x => x.id)).to.not.include(Number(v('hamburguer_id'))));"
        ]
       }
      }
