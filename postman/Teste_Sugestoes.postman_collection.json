  {
   "name": "1. Sugestões",
   "item": [
    {
     "name": "CT-01 Cesta vazia → mais pedidos primeiro",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{base_url}}/consultas/restaurantes/{{restaurante_id}}/sugestoes?limite=10",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "consultas",
        "restaurantes",
        "{{restaurante_id}}",
        "sugestoes"
       ],
       "query": [
        {
         "key": "limite",
         "value": "10"
        }
       ]
      },
      "description": ""
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const v = (k) => pm.collectionVariables.get(k);",
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const s = pm.response.json().sugestoes;",
         "pm.test('Refrigerante (4 vendidos) em 1º', () => pm.expect(s[0].id).to.eql(Number(v('refri_id'))));",
         "pm.test('Motivo: mais pedidos', () => pm.expect(s[0].motivo).to.include('mais pedidos'));",
         "pm.test('Sorvete não conta o pedido não aceito', () => pm.expect(s.find(x => x.id === Number(v('sorvete_id'))).vezes_pedido).to.eql(0));"
        ]
       }
      }
     ]
    },
    {
     "name": "CT-02 Hambúrguer na cesta → Batata (pedida junto) em 1º",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{base_url}}/consultas/restaurantes/{{restaurante_id}}/sugestoes?na_cesta={{hamburguer_id}}",
