              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-10 Corpo sem quantidade → 422",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/{{produto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "{{produto_id}}"
              ]
            },
            "description": "Campo obrigatório ausente.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('Erro informa campo obrigatório', () => pm.expect(JSON.stringify(pm.response.json().detail)).to.include('missing'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT-11 Produto que não está na cesta → 404",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cesta/itens/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cesta",
                "itens",
                "999999"
              ]
            },
            "description": "Não é possível alterar um item que não foi adicionado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
